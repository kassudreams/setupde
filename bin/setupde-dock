#!/bin/bash
# Dock in the middle of waybar: pinned apps + open windows, Windows-style.
# A pinned app's icon is a launcher while the app is closed; once it runs,
# its windows show up as taskbar buttons instead (click = focus,
# middle-click = close, right-click = minimise), so nothing appears twice.
#
#   setupde-dock build          (re)generate the dock and reload waybar
#   setupde-dock watch          keep the dock in sync with open windows (autostart)
#   setupde-dock pin            pick an app to pin (the + button, Super+Shift+Space)
#   setupde-dock unpin ID       remove an app (right-click its icon)
#   setupde-dock launch ID      start an app (left-click its icon)
#   setupde-dock icon ID        print icon path + name (used by waybar)
#
# Pinned apps are stored one per line (desktop file names) in
# ~/.config/setupde/dock.list - you can edit or reorder that file by hand,
# then run `setupde-dock build`.

set -u

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
LIST="$CONF/setupde/dock.list"
OUT="$CONF/waybar/dock.jsonc"
ICON_SIZE=26
RUNNING="${XDG_RUNTIME_DIR:-/tmp}/setupde-dock-running"
SIGNAL=9   # waybar refresh signal for the pinned icons

app_dirs() {
	local d
	for d in "${XDG_DATA_HOME:-$HOME/.local/share}" \
	         /var/lib/flatpak/exports/share \
	         "$HOME/.local/share/flatpak/exports/share" \
	         /usr/local/share /usr/share; do
		[ -d "$d/applications" ] && echo "$d/applications"
	done
}

# Path of the .desktop file for an id like "firefox.desktop"
desktop_file() {
	local d
	for d in $(app_dirs); do
		[ -f "$d/$1" ] && { echo "$d/$1"; return 0; }
	done
	return 1
}

desktop_key() { # file key -> first value of key in [Desktop Entry]
	awk -F= -v k="$2" '
		/^\[/ { sec = $0 }
		sec == "[Desktop Entry]" && $1 == k { sub(/^[^=]*=/, ""); print; exit }' "$1"
}

# Resolve an icon name to a file, preferring the Papirus-Dark theme
icon_path() {
	local name="$1" base dir ext
	if [ -z "$name" ]; then name=application-x-executable; fi
	case "$name" in /*) [ -f "$name" ] && { echo "$name"; return; } ;; esac
	for base in "${XDG_DATA_HOME:-$HOME/.local/share}/icons" /var/lib/flatpak/exports/share/icons \
	            "$HOME/.local/share/flatpak/exports/share/icons" /usr/share/icons; do
		for dir in Papirus-Dark/64x64/apps Papirus/64x64/apps Papirus-Dark/48x48/apps \
		           hicolor/scalable/apps hicolor/256x256/apps hicolor/128x128/apps \
		           hicolor/64x64/apps hicolor/48x48/apps Adwaita/scalable/apps; do
			for ext in svg png; do
				[ -f "$base/$dir/$name.$ext" ] && { echo "$base/$dir/$name.$ext"; return; }
			done
		done
	done
	for ext in svg png xpm; do
		[ -f "/usr/share/pixmaps/$name.$ext" ] && { echo "/usr/share/pixmaps/$name.$ext"; return; }
	done
	[ "$name" != application-x-executable ] && icon_path application-x-executable
}

default_list() {
	local id
	for id in firefox.desktop chromium.desktop thunar.desktop foot.desktop \
	          steam.desktop net.lutris.Lutris.desktop lutris.desktop; do
		desktop_file "$id" >/dev/null && echo "$id"
	done
}

build() {
	mkdir -p "$(dirname "$LIST")" "$(dirname "$OUT")"
	[ -f "$LIST" ] || default_list > "$LIST"

	local mods=() defs="" i=0 id
	while IFS= read -r id; do
		[ -n "$id" ] || continue
		desktop_file "$id" >/dev/null || continue
		mods+=("\"image#dock$i\"")
		defs+="  \"image#dock$i\": {
    \"exec\": \"setupde-dock icon $id\",
    \"interval\": 3600,
    \"signal\": $SIGNAL,
    \"size\": $ICON_SIZE,
    \"tooltip\": true,
    \"on-click\": \"setupde-dock launch $id\",
    \"on-click-right\": \"setupde-dock unpin $id\",
    \"on-click-middle\": \"setupde-dock unpin $id\"
  },
"
		i=$((i + 1))
	done < "$LIST"
	mods+=("\"wlr/taskbar\"" "\"custom/dock-add\"")

	local IFS=,
	cat > "$OUT" <<EOF
// Generated by setupde-dock - edit ~/.config/setupde/dock.list instead
{
  "modules-center": [${mods[*]}],
$defs  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": $ICON_SIZE,
    "icon-theme": "Papirus-Dark",
    "tooltip-format": "{title}",
    "sort-by-app-id": true,
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize-raise"
  },
  "custom/dock-add": {
    "format": "+",
    "tooltip-format": "Pin an app to the dock (Super+Shift+Space)\\nRight-click an icon to unpin it",
    "on-click": "setupde-dock pin"
  }
}
EOF
	pkill -SIGUSR2 -x waybar 2>/dev/null || true
}

pin() {
	# Menu of installed apps with icons (fuzzel dmenu icon syntax)
	local map choice id
	map="$(mktemp)"
	for d in $(app_dirs); do
		for f in "$d"/*.desktop; do
			[ -f "$f" ] || continue
			[ "$(desktop_key "$f" NoDisplay)" = true ] && continue
			[ "$(desktop_key "$f" Hidden)" = true ] && continue
			[ "$(desktop_key "$f" Type)" = Application ] || continue
			printf '%s\t%s\t%s\n' "$(desktop_key "$f" Name)" "$(basename "$f")" "$(desktop_key "$f" Icon)"
		done
	done | sort -u -t "$(printf '\t')" -k2,2 | sort -f > "$map"

	choice="$(while IFS="$(printf '\t')" read -r name _ ic; do
			printf '%s\0icon\037%s\n' "$name" "$ic"
		done < "$map" | fuzzel --dmenu --prompt "Pin to dock: " --index)"
	if [ -n "$choice" ]; then
		id="$(awk -F'\t' -v n="$((choice + 1))" 'NR == n { print $2 }' "$map")"
		if [ -n "$id" ] && ! grep -qx "$id" "$LIST" 2>/dev/null; then
			echo "$id" >> "$LIST"
			build
		fi
	fi
	rm -f "$map"
}

unpin() {
	[ -f "$LIST" ] || return
	grep -vx "$1" "$LIST" > "$LIST.tmp"; mv "$LIST.tmp" "$LIST"
	build
}

launch() {
	local f exec_line
	if command -v gtk-launch >/dev/null; then
		gtk-launch "${1%.desktop}" >/dev/null 2>&1 &
		return
	fi
	f="$(desktop_file "$1")" || return
	exec_line="$(desktop_key "$f" Exec | sed 's/ %[a-zA-Z]//g')"
	setsid sh -c "$exec_line" >/dev/null 2>&1 &
}

# Lower-case names a running window of this app could have as its class
app_classes() {
	local f="$1" id="${2%.desktop}" exe
	echo "$id" | tr '[:upper:]' '[:lower:]'
	echo "${id##*.}" | tr '[:upper:]' '[:lower:]'     # net.lutris.Lutris -> lutris
	desktop_key "$f" StartupWMClass | tr '[:upper:]' '[:lower:]'
	exe="$(desktop_key "$f" Exec | awk '{print $1}')"
	[ "$exe" = env ] && exe="$(desktop_key "$f" Exec | awk '{for (i = 2; i <= NF; i++) if ($i !~ /=/) { print $i; exit }}')"
	basename "${exe:-x}" | tr '[:upper:]' '[:lower:]'
}

icon() {
	local f c
	f="$(desktop_file "$1")" || return
	# Running -> hide the launcher (the taskbar part of the dock shows it).
	# waybar only hides an image when its path doesn't exist; empty output
	# would keep the old icon, so print a path that can't exist.
	if [ -s "$RUNNING" ]; then
		while IFS= read -r c; do
			[ -n "$c" ] && grep -qxF "$c" "$RUNNING" && { echo "/nonexistent/hidden"; return 0; }
		done < <(app_classes "$f" "$1" | sort -u)
	fi
	icon_path "$(desktop_key "$f" Icon)"
	desktop_key "$f" Name
}

update_running() {
	local new
	new="$(hyprctl clients -j 2>/dev/null | grep -o '"class": *"[^"]*"' |
		sed 's/.*: *"\(.*\)"/\1/' | tr '[:upper:]' '[:lower:]' | sort -u)"
	if [ "$new" != "$(cat "$RUNNING" 2>/dev/null)" ]; then
		printf '%s\n' "$new" > "$RUNNING"
		pkill "-RTMIN+$SIGNAL" -x waybar 2>/dev/null || true
	fi
}

watch() {
	local sock="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"
	update_running
	if command -v socat >/dev/null && [ -S "$sock" ]; then
		socat -U - "UNIX-CONNECT:$sock" | while IFS= read -r ev; do
			case "$ev" in openwindow*) update_running ;; closewindow*) sleep 0.3; update_running ;; esac
		done
	else
		while sleep 2; do update_running; done
	fi
}

case "${1:-build}" in
	build)  build ;;
	pin)    pin ;;
	unpin)  unpin "${2:?app id}" ;;
	launch) launch "${2:?app id}" ;;
	icon)   icon "${2:?app id}" ;;
	watch)  watch ;;
	*) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
