#!/bin/sh
# HDR on Hyprland (edits ~/.config/hypr/monitors.lua; Hyprland reloads it).
# HDR is on or off for the whole screen; apps never switch it by themselves.
#   setupde-hdr game   HDR only while game mode is on (Super+G) - the default
#   setupde-hdr on     HDR all the time
#   setupde-hdr off    never HDR, not even in game mode
#   setupde-hdr        show the current setting
f="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitors.lua"
look="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/look.lua"
[ -f "$f" ] || { echo "no $f" >&2; exit 1; }
set_cm()   { sed -i "s/^\([[:space:]]*cm[[:space:]]*=[[:space:]]*\)\"[^\"]*\"/\1\"$1\"/" "$f"; }
set_game() { sed -i "s/^\([[:space:]]*hdr_in_game_mode[[:space:]]*=[[:space:]]*\)[a-z]*/\1$1/" "$f"; }
# older configs let apps switch HDR when they went full screen: never again
no_auto()  { [ -f "$look" ] && sed -i "s/cm_auto_hdr[[:space:]]*=[[:space:]]*[0-9]/cm_auto_hdr = 0/" "$look"; }
case "${1:-}" in
	game|auto) no_auto; set_game true;  set_cm srgb; msg="HDR: on in game mode (Super+G), off otherwise" ;;
	on)        no_auto; set_game true;  set_cm hdr;  msg="HDR: always on" ;;
	off)       no_auto; set_game false; set_cm srgb; msg="HDR: off, also in game mode" ;;
	"")   cm="$(sed -n 's/^[[:space:]]*cm[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n1)"
	      game="$(sed -n 's/^[[:space:]]*hdr_in_game_mode[[:space:]]*=[[:space:]]*\([a-z]*\).*/\1/p' "$f" | head -n1)"
	      if [ "$cm" != srgb ]; then echo "HDR: always on (cm = $cm)"
	      elif [ "$game" = false ]; then echo "HDR: off, also in game mode"
	      else echo "HDR: on in game mode (Super+G), off otherwise"; fi
	      exit 0 ;;
	*)    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
notify-send -t 2500 "Display" "$msg" 2>/dev/null || echo "$msg"
