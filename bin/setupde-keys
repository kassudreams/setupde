#!/bin/sh
# All keyboard shortcuts of the PikaOS Hyprland desktop (Super+F1, or
# right-click the launcher icon in the panel). Just a list to read.
cat <<'EOF' | fuzzel --dmenu --prompt "Shortcuts: " --lines 20 --width 52 >/dev/null
Super+Space            app launcher
Super+Enter            terminal
Super+E / Super+B      files / browser
Super+V                clipboard history
Super+← / →            snap left / right half (again: 1/3, 2/3)
Super+↑                big (a half: its top quarter)
Super+↓                own size (a half: bottom quarter; own size: minimize)
Super+T                arrange all windows into tiles (again: undo)
Super+M                big <-> own size (or double-click the title bar)
Super+H                minimize (click it in the dock to bring it back)
Super+C                own size, centred
Super+F                full screen
Super+Q / Alt+F4       close
Alt+Tab                next window
Super+Alt+arrows       focus the window in that direction
Super+1..4             workspace 1-4 (Shift: move the window there)
Super+Ctrl+← / →       previous / next workspace
Super+P                keep on top, on every workspace
Super+G                game mode: HDR + VRR on, effects off
Super+drag / right-drag   move / resize a window
Drag to a screen edge  snap there (left/right: half, top: big, corner: quarter)
Super+L                lock the screen
Super+N                clear notifications
Print                  screenshot of an area (Shift: whole screen)
Super+Esc              power menu
Super+F1               this list
EOF
