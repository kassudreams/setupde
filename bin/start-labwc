#!/bin/sh
# Start a labwc session. Used by greetd/tuigreet, or type `start-labwc` on a TTY.
# dbus-run-session gives the session its own D-Bus bus (needed for
# notifications, portals, tray icons, etc. on Void, which has no systemd).
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc:wlroots

# Hybrid graphics (e.g. a CPU with built-in graphics + an NVIDIA card): use the
# NVIDIA card, which is where the monitor is normally plugged in.
# Override by setting WLR_DRM_DEVICES yourself (e.g. /dev/dri/card1).
if [ -z "${WLR_DRM_DEVICES:-}" ]; then
	for card in /sys/class/drm/card[0-9]*; do
		case "${card##*/}" in *-*) continue ;; esac  # skip connectors (card1-DP-1)
		[ "$(cat "$card/device/vendor" 2>/dev/null)" = 0x10de ] || continue
		export WLR_DRM_DEVICES="/dev/dri/${card##*/}"
		break
	done
fi

mkdir -p "$HOME/.local/state"
exec dbus-run-session labwc "$@" > "$HOME/.local/state/labwc.log" 2>&1
