#!/bin/bash
# Rebuild Hyprland plugins (title bars) after PikaOS updates Hyprland.
#   setupde-rebuild-plugins          install build dependencies, rebuild, reload
#   setupde-rebuild-plugins --deps   only install the build dependencies
#
# hyprpm builds the plugins against the source of the Hyprland you have, so it
# needs everything Hyprland's build checks for. New Hyprland versions add to
# that list (0.57: libcanberra, sdbus-c++, newer hyprland-protocols), so it's
# installed here on every rebuild. Packages PikaOS doesn't have are skipped.

DEPS=(
	cmake meson ninja-build cpio pkg-config git g++ gcc make
	glslang-dev glslang-tools hyprwayland-scanner hyprland-protocols
	libaquamarine-dev libhyprlang-dev libhyprcursor-dev libhyprutils-dev libhyprgraphics-dev
	libxkbcommon-dev uuid-dev libwayland-dev wayland-protocols
	libcairo2-dev libpango1.0-dev libpixman-1-dev libxcursor-dev libdrm-dev
	libinput-dev libeis-dev libgbm-dev libglib2.0-dev libre2-dev libmuparser-dev
	liblcms2-dev liblua5.5-dev libgles-dev libegl-dev libopengl-dev libudis86-dev
	libxcb1-dev libxcb-render0-dev libxcb-xfixes0-dev libxcb-icccm4-dev
	libxcb-composite0-dev libxcb-res0-dev libxcb-errors-dev
	libhyprwire-dev hyprwire-dev libreadline-dev libtomlplusplus-dev libglaze-dev
	libcanberra-dev libsdbus-c++-dev
)

install_deps() {
	local p avail=() missing=()
	for p in "${DEPS[@]}"; do
		if apt-cache show "$p" >/dev/null 2>&1; then avail+=("$p"); else missing+=("$p"); fi
	done
	echo "==> Installing Hyprland's build dependencies"
	[ "${#missing[@]}" -eq 0 ] || echo "    (not in PikaOS, skipped: ${missing[*]})"
	if ! sudo apt-get install -y "${avail[@]}"; then
		# one package that can't be installed shouldn't stop the others
		for p in "${avail[@]}"; do sudo apt-get install -y "$p" >/dev/null 2>&1 || echo "    couldn't install $p"; done
	fi
	sudo apt-get build-dep -y hyprland >/dev/null 2>&1 || true
}

install_deps
[ "${1:-}" = --deps ] && exit 0

echo "==> Rebuilding the plugins for Hyprland $(hyprctl version -j 2>/dev/null | sed -n 's/.*"tag": *"\([^"]*\)".*/\1/p' | head -n1)"
# hyprbars includes <lua.h>, which Debian/PikaOS keeps in /usr/include/lua5.5
CXXFLAGS="-O2 $(pkg-config --cflags lua5.5 2>/dev/null || echo -I/usr/include/lua5.5)"
export CXXFLAGS
hyprpm update -f && hyprpm reload && hyprctl reload
