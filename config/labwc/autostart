# labwc autostart - run once when labwc starts (sourced by sh).
# Long-running programs MUST end with '&'.

# Audio: PipeWire (WirePlumber + pipewire-pulse are loaded by pipewire
# itself via /etc/pipewire/pipewire.conf.d, set up by install.sh)
pgrep -u "$USER" -x pipewire >/dev/null || pipewire >/dev/null 2>&1 &

# Monitor resolution / refresh rate / scale (~/.config/kanshi/config)
kanshi >/dev/null 2>&1 &

# Wallpaper: put an image at ~/.config/labwc/wallpaper (any jpg/png) to use it
if [ -f "$HOME/.config/labwc/wallpaper" ]; then
	swaybg -m fill -i "$HOME/.config/labwc/wallpaper" >/dev/null 2>&1 &
else
	swaybg -c '#1e1e2e' >/dev/null 2>&1 &
fi

# Panel, notifications, auth agent, tray applets
waybar >/dev/null 2>&1 &
mako >/dev/null 2>&1 &

for agent in /usr/libexec/polkit-gnome-authentication-agent-1 \
             /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1; do
	[ -x "$agent" ] && { "$agent" >/dev/null 2>&1 & break; }
done

command -v nm-applet >/dev/null && nm-applet --indicator >/dev/null 2>&1 &
command -v blueman-applet >/dev/null && blueman-applet >/dev/null 2>&1 &

# Clipboard history (Super+V)
command -v cliphist >/dev/null && wl-paste --watch cliphist store >/dev/null 2>&1 &

# Night light (warmer colours after sunset). Remove if you don't want it.
command -v wlsunset >/dev/null && wlsunset -t 4000 -T 6500 -S 07:00 -s 20:00 >/dev/null 2>&1 &

# Idle: lock after 5 min, screen off after 10 min, lock before suspend
swayidle -w \
	timeout 300 'swaylock -f' \
	timeout 600 'wlopm --off \*' resume 'wlopm --on \*' \
	before-sleep 'swaylock -f' >/dev/null 2>&1 &
