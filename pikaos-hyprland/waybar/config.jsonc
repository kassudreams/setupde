// Waybar for PikaOS Hyprland - setupde. Reference: man 5 waybar
// The dock in the middle is generated by `setupde-dock` into dock.jsonc.
{
  "include": ["~/.config/waybar/dock.jsonc"],
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 6,

  "modules-left": ["custom/launcher", "ext/workspaces", "wlr/taskbar"],
  "modules-right": [
    "tray",
    "group/hardware",
    "custom/nightlight",
    "idle_inhibitor",
    "pulseaudio",
    "network",
    "clock",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰀻",
    "tooltip-format": "Applications (Super+Space)",
    "on-click": "fuzzel"
  },

  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-id": true
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "icon-theme": "Papirus-Dark",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize-raise"
  },

  "group/hardware": {
    "orientation": "horizontal",
    "modules": ["cpu", "temperature", "custom/gpu", "memory", "custom/watts"]
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip-format": "CPU load: {usage}%\nClock: {avg_frequency} GHz",
    "on-click": "foot -e btop"
  },

  "temperature": {
    "interval": 2,
    @CPU_TEMP_SOURCE@
    "critical-threshold": 85,
    "format": "{temperatureC}°C",
    "format-critical": "{temperatureC}°C",
    "tooltip-format": "CPU temperature: {temperatureC}°C"
  },

  "custom/gpu": {
    "exec": "setupde-sysinfo gpu",
    "return-type": "json",
    "interval": 2,
    "on-click": "foot -e nvtop"
  },

  "memory": {
    "interval": 3,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "Memory: {used:0.1f} / {total:0.1f} GiB\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB"
  },

  "custom/watts": {
    "exec": "setupde-sysinfo power",
    "return-type": "json",
    "interval": 3
  },

  "custom/nightlight": {
    "exec": "setupde-nightlight status",
    "return-type": "json",
    "interval": 30,
    "signal": 8,
    "on-click": "setupde-nightlight",
    "on-click-right": "setupde-nightlight toggle"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "", "deactivated": "" },
    "tooltip-format-activated": "Screen will stay awake",
    "tooltip-format-deactivated": "Screen will lock when idle"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": { "headphone": "", "default": ["", "", ""] },
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰖪 offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#6c7086'>W{}</span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Power menu (Super+Esc)",
    "on-click": "setupde-powermenu"
  }
}
